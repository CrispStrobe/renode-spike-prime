// SPDX-License-Identifier: MIT
// SPIKE Prime machine assembled from source-only board models.

using "spike-prime-brick-devices.repl"

// STM32F413 SRAM1 (256 KiB) + SRAM2 (64 KiB) are contiguous.
sramUpper: Memory.MappedMemory @ sysbus 0x20040000
    size: 0x10000

primeStorageMemory: Memory.MappedMemory @ none
    size: 0x2000000

primeStorageMux: SPI.SPIMultiplexer @ spi2
    init:
        SetActiveLow 0

primeStorage: SPI.GenericSpiFlash @ primeStorageMux 0
    underlyingMemory: primeStorageMemory
    manufacturerId: 0xef
    memoryType: 0x40
    capacityCode: 0x19
    writeStatusCanSetWriteEnable: false
    sectorSizeKB: 64
    secondaryStatusRegisterReadCommand: 0x35

gpioPortB:
    12 -> primeStorageMux@0

spi2:
    DMATransmit -> dma1@4

spi1:
    DMAReceive -> dma2@2
    DMATransmit -> dma2@3
