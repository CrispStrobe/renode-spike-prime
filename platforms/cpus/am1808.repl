// TI AM1808 subset required for a truthful ARM926/AINTC/UART boot boundary.
// Addresses and interrupt numbers follow TI SPRUH82C and the AM1808 datasheet.

cpu: CPU.ARMv7A @ sysbus
    cpuType: "arm926"
    // The EV3 production AM1808 runs its ARM926EJ-S at 300 MHz. Renode uses
    // this value to convert executed guest instructions into virtual time.
    PerformanceInMips: 300
    init:
        ModelID 0x41069265
        ExceptionVectorAddress 0xFFFF0000
        PC 0xFFFF0000

aintc: IRQControllers.TI_DA8xx_AINTC @ sysbus 0xFFFEE000
    IRQ -> cpu@0
    FIQ -> cpu@1

edma0tc0: DMA.TI_DA8xx_EDMA3TC @ sysbus 0x01C08000
    configuration: 0x212
    IRQ -> aintc@13

edma0tc1: DMA.TI_DA8xx_EDMA3TC @ sysbus 0x01C08400
    configuration: 0x212
    IRQ -> aintc@32

edma0cc: DMA.TI_DA8xx_EDMA3CC @ sysbus 0x01C00000
    controllerIndex: 0
    IRQ -> aintc@11
    ErrorIRQ -> aintc@12
    init:
        AttachTransferController edma0tc0 0
        AttachTransferController edma0tc1 1

// The ROM and I2C EEPROM boot stages are intentionally not distributed or
// executed. These constructor presets describe the public, deterministic
// handoff state they leave for an EV3 application image.
psc0: Miscellaneous.TI_DA8xx_PSC @ sysbus 0x01C10000
    moduleCount: 16
    initiallyEnabledModules: 0x40C0
    powerDomain1Module: 15
    postBootloaderState: true

pll0: Miscellaneous.TI_DA8xx_PLLC @ sysbus 0x01C11000
    primary: true
    postBootloaderState: true

syscfg0: Miscellaneous.TI_DA8xx_SYSCFG0 @ sysbus 0x01C14000
    bootConfiguration: 0
    postBootloaderState: true

timer0: Timers.TI_DA8xx_Timer64 @ sysbus 0x01C20000
    IRQ12 -> aintc@21
    IRQ34 -> aintc@22

// EV3 populates MMC/SD0 only. Named DMA outputs preserve the public AM1808
// event mapping: receive channel 16 and transmit channel 17 on EDMA0.
mmcsd0: SD.TI_DA8xx_MMCSD @ sysbus 0x01C40000
    IRQ -> aintc@16
    SDIOIRQ -> aintc@17
    RxDMARequest -> edma0cc@16
    TxDMARequest -> edma0cc@17

// AM1808 maps its 8 KiB ARM-local vector RAM at the high-vector address.
armLocalRam: Memory.MappedMemory @ sysbus 0xFFFF0000
    size: 0x2000

// The boot ROM contents are deliberately absent; never substitute recovery
// firmware. This mapping reserves the documented 64 KiB address window.
armLocalRom: Memory.MappedMemory @ sysbus 0x11700000
    size: 0x10000

sharedRam: Memory.MappedMemory @ sysbus 0x80000000
    size: 0x20000

ddr: Memory.MappedMemory @ sysbus 0xC0000000
    size: 0x4000000

uart0: UART.NS16550 @ sysbus 0x01C42000
    wideRegisters: true
    -> aintc@25

uart1: UART.NS16550 @ sysbus 0x01D0C000
    wideRegisters: true
    -> aintc@53

uart2: UART.NS16550 @ sysbus 0x01D0D000
    wideRegisters: true
    -> aintc@61

pll1: Miscellaneous.TI_DA8xx_PLLC @ sysbus 0x01E1A000
    primary: false
    postBootloaderState: true

psc1: Miscellaneous.TI_DA8xx_PSC @ sysbus 0x01E27000
    moduleCount: 32
    initiallyEnabledModules: 0x80000040
    powerDomain1Module: -1
    postBootloaderState: true

edma1tc0: DMA.TI_DA8xx_EDMA3TC @ sysbus 0x01E38000
    configuration: 0x213
    IRQ -> aintc@95

edma1cc: DMA.TI_DA8xx_EDMA3CC @ sysbus 0x01E30000
    controllerIndex: 1
    IRQ -> aintc@93
    ErrorIRQ -> aintc@94
    init:
        AttachTransferController edma1tc0 0

sysbus:
    init:
        Tag <0x01C00000, 0x01FFFFFF> "AM1808 peripheral configuration bus"
